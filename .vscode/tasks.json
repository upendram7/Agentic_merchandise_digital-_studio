{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Agentic Studio API",
			"type": "shell",
			"command": "python",
			"args": [
				"-m",
				"uvicorn",
				"app.main:app",
				"--reload",
				"--host",
				"0.0.0.0",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": [
				"$python"
			],
			"group": "build"
		}
	]
}